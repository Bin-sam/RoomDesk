    <UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>RoomDesk</AssemblyName>
  <ServerGarbageCollection>false</ServerGarbageCollection></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Core/Core.csproj" /></ItemGroup>
<ItemGroup><RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="100663296" /><RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" /></ItemGroup><ItemGroup><EmbeddedResource Include="Resources/update.ps1" LogicalName="RoomDesk.Windows.Resources.update.ps1" /></ItemGroup></Project>
