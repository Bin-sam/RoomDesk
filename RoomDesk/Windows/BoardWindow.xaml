<Window x:Class="RoomDesk.Windows.BoardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="栖间 · 房态管理原型" Width="1366" Height="768" MinWidth="950" MinHeight="620" WindowState="Maximized" Background="#F3F6F5" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Foreground="#20392F" WindowStartupLocation="CenterScreen">
 <Grid Margin="24,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Border Background="#204B3A" CornerRadius="10" Padding="11,4" Margin="0,0,12,0"><TextBlock Text="栖" FontSize="27" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="房态总览" FontSize="26" FontWeight="Bold"/><TextBlock Text="栖间 · 前台工作台" FontSize="11" Foreground="#617469" Margin="0,3,0,0"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="入住记录" Click="StayRecords_Click"/><Button Content="操作记录" Click="History_Click"/><Button Content="账单" Click="Bills_Click"/><Button Content="数据与安全" Click="Security_Click"/><Button Content="房间管理 ↗" Click="Rooms_Click" Background="#24533F" Foreground="White" FontWeight="Bold" Margin="0"/></StackPanel></DockPanel>
  <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,14">
   <Border Background="White" BorderBrush="#167054" BorderThickness="0,3,0,0" CornerRadius="7" Padding="14,11" Margin="0,0,8,0"><DockPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="可入住" Foreground="#167054" FontSize="15" FontWeight="Bold"/><TextBlock Text="可直接办理入住" Foreground="#617469" FontSize="10" Margin="0,5,0,0"/></StackPanel><TextBlock Text="{Binding ReadyCount}" Foreground="#167054" FontSize="36" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
   <Border Background="White" BorderBrush="#235BBA" BorderThickness="0,3,0,0" CornerRadius="7" Padding="14,11" Margin="0,0,8,0"><DockPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="在住" Foreground="#235BBA" FontSize="15" FontWeight="Bold"/><TextBlock Text="当前已入住客房" Foreground="#617469" FontSize="10" Margin="0,5,0,0"/></StackPanel><TextBlock Text="{Binding OccupiedCount}" Foreground="#235BBA" FontSize="36" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
   <Border Background="White" BorderBrush="#92600D" BorderThickness="0,3,0,0" CornerRadius="7" Padding="14,11" Margin="0,0,8,0"><DockPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="已预订" Foreground="#92600D" FontSize="15" FontWeight="Bold"/><TextBlock Text="等待客人到店" Foreground="#617469" FontSize="10" Margin="0,5,0,0"/></StackPanel><TextBlock Text="{Binding ReservedCount}" Foreground="#92600D" FontSize="36" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
   <Border Background="White" BorderBrush="#B94515" BorderThickness="0,3,0,0" CornerRadius="7" Padding="14,11" Margin="0,0,8,0"><DockPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="待清扫" Foreground="#B94515" FontSize="15" FontWeight="Bold"/><TextBlock Text="含在住及维修房间" Foreground="#617469" FontSize="10" Margin="0,5,0,0"/></StackPanel><TextBlock Text="{Binding DirtyCount}" Foreground="#B94515" FontSize="36" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
   <Border Background="White" BorderBrush="#7742A2" BorderThickness="0,3,0,0" CornerRadius="7" Padding="14,11" Margin="0,0,8,0"><DockPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="维修 / 停用" Foreground="#7742A2" FontSize="15" FontWeight="Bold"/><TextBlock Text="暂不可安排入住" Foreground="#617469" FontSize="10" Margin="0,5,0,0"/></StackPanel><TextBlock Text="{Binding UnavailableCount}" Foreground="#7742A2" FontSize="36" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
  </UniformGrid>
  <DockPanel Grid.Row="2" Margin="0,0,0,12">
   <TextBox x:Name="SearchBox" Width="160" ToolTip="按房号搜索" TextChanged="Filter_Changed" Padding="9,7"/>
   <ComboBox x:Name="FloorBox" Width="110" Margin="8,0" SelectionChanged="Filter_Changed" Padding="9,7"/>
   <ComboBox x:Name="StatusBox" Width="140" SelectionChanged="Filter_Changed" Padding="9,7"><ComboBoxItem Content="全部状态" Tag="all" IsSelected="True"/><ComboBoxItem Content="可入住" Tag="ready"/><ComboBoxItem Content="在住" Tag="occupied"/><ComboBoxItem Content="已预订" Tag="reserved"/><ComboBoxItem Content="待清扫（全部）" Tag="dirty"/><ComboBoxItem Content="维修中" Tag="maintenance"/><ComboBoxItem Content="已停用" Tag="disabled"/></ComboBox>
   <Button Content="刷新" Click="Refresh_Click" Margin="8,0,0,0" Padding="12,7" DockPanel.Dock="Right"/>
   <TextBlock Text="{Binding ResultText}" Foreground="#52675A" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0"/>
  </DockPanel>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="232"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="BoardArea" SizeChanged="Board_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2">
    <ItemsControl ItemsSource="{Binding Floors}"><ItemsControl.ItemTemplate><DataTemplate>
     <Grid Margin="0,2,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,7,0"><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextAlignment="Center"/><TextBlock Text="楼" FontSize="11" TextAlignment="Center" Margin="0,3,0,0"/></StackPanel>
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Rooms}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding RoomColumns, RelativeSource={RelativeSource AncestorType=Window}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
       <Button Click="Room_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Number}" Height="116" MinWidth="0" Margin="0,0,7,0" Padding="0" BorderThickness="0" ToolTip="{Binding GuestLabel}">
        <Button.Template><ControlTemplate TargetType="Button">
         <Border x:Name="CardBorder" CornerRadius="7" Background="{Binding SoftColor}" BorderBrush="{Binding Color}" BorderThickness="1,4,1,1" Padding="9,7">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <DockPanel><TextBlock Text="{Binding Number}" FontSize="29" FontWeight="Bold" Foreground="#203B31"/><TextBlock Text="{Binding Type}" FontSize="10" Foreground="#596E61" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3,0,0,0"/></DockPanel>
           <TextBlock Grid.Row="1" Text="{Binding BoardCaption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#576D5F"/><Style.Triggers><DataTrigger Binding="{Binding Occupancy}" Value="Occupied"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#244B83"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
           <DockPanel Grid.Row="2"><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="14"/><TextBlock Text="待清扫" FontSize="10" FontWeight="Bold" Foreground="#B94515" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsClean}" Value="False"/><Condition Binding="{Binding Occupancy}" Value="Occupied"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel>
          </Grid>
         </Border>
         <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#183F34"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardBorder" Property="BorderThickness" Value="2,4,2,2"/><Setter TargetName="CardBorder" Property="BorderBrush" Value="#183F34"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Button.Template>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="14,0,0,0"><Border Background="White" BorderBrush="#D9E3DC" BorderThickness="1" CornerRadius="9" Padding="16" VerticalAlignment="Top"><StackPanel>
    <TextBlock Text="房间详情" FontSize="12" Foreground="#52695C"/><TextBlock Text="{Binding Selected.Number, TargetNullValue=请选择房间}" FontSize="40" FontWeight="Bold" Margin="0,10,0,6"/>
    <TextBlock Text="{Binding Selected.Subtitle}" Foreground="#596E60" FontSize="12"/><TextBlock Text="{Binding Selected.Status}" Foreground="{Binding Selected.Color}" FontSize="20" FontWeight="Bold" Margin="0,12,0,8"/>
    <TextBlock Text="{Binding Selected.CleanLabel}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#516958"/><Style.Triggers><DataTrigger Binding="{Binding Selected.IsClean}" Value="False"><Setter Property="Foreground" Value="#B94515"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <TextBlock Text="{Binding Selected.GuestLabel}" TextWrapping="Wrap" FontSize="17" FontWeight="Bold" Foreground="#244B83" Margin="0,10,0,0"/>
    <Separator Margin="0,12"/><Button Content="查看入住信息" Click="Guest_Click" Margin="0,0,0,7" Padding="10,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Selected.Occupancy}" Value="Occupied"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <ItemsControl ItemsSource="{Binding Selected.Actions}" IsEnabled="{Binding CanOperate}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Key}" Click="Action_Click" FontSize="13" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,7"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="退房后转为待清扫；清扫完成后才可再次入住。" TextWrapping="Wrap" FontSize="11" Foreground="#617568" Margin="0,8,0,0"/>
   </StackPanel></Border></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="4" Text="{Binding Feedback}" Foreground="#3E6350" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
 </Grid>
</Window>
